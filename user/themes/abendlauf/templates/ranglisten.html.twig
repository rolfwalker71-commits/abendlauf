{% extends 'partials/base.html.twig' %}

{% block content %}
{# Die Ranglisten liegen als Dateien an dieser Seite, jede mit Jahr und
   Lauf in ihrer .meta.yaml. Daraus wird eine Matrix: eine Zeile pro
   Jahr, eine Spalte pro Abend. #}
{% set listen = page.media.all|filter(m => m.meta.art|default('') == 'rangliste' and m.meta.jahr|default(0) > 0) %}

{# PHP wandelt Zahlen-Zeichenketten in Ganzzahl-Schlüssel um, und
   array_merge nummeriert Ganzzahl-Schlüssel neu durch statt sie zu
   ersetzen. Deshalb tragen beide Ebenen ein Buchstaben-Präfix. #}
{% set jahre = {} %}
{% for name, datei in listen %}
  {% set jk = 'j' ~ datei.meta.jahr %}
  {% set lk = 'l' ~ (datei.meta.lauf|default('gesamt')) %}
  {% set bisher = jahre[jk]|default({ jahr: datei.meta.jahr, dateien: {} }) %}
  {% set jahre = jahre|merge({ (jk): {
        jahr: datei.meta.jahr,
        dateien: bisher.dateien|merge({ (lk): datei })
     } }) %}
{% endfor %}

{# Nach Jahr absteigend sortieren #}
{% set jahrgaenge = [] %}
{% for jk, eintrag in jahre %}
  {% set jahrgaenge = jahrgaenge|merge([eintrag.jahr]) %}
{% endfor %}
{% set jahrgaenge = jahrgaenge|sort|reverse %}
{% set aktuell = jahrgaenge|first %}

{% set spalten = { '1': '1. Abend', '2': '2. Abend', '3': '3. Abend', 'gesamt': 'Gesamt' } %}

{# Zahlen zur Seite statt Dekoration — sie stehen ohnehin in den
   Daten und sagen mehr als ein unscharfes Foto. #}
{# Fehlende Jahre benennen, statt „lückenlos" zu behaupten. Wo der
   Anlass gar nicht stattfand, steht der Grund dabei — sonst liest sich
   die Lücke wie eine fehlende Datei. #}
{% set ausgefallen = {} %}
{% for a in config.site.verein.ausgefallen|default([]) %}
  {% set ausgefallen = ausgefallen|merge({ ('j' ~ a.jahr): a.grund|default('abgesagt') }) %}
{% endfor %}
{% set fehlende = [] %}
{% for j in (jahrgaenge|last)..aktuell %}
  {% if j not in jahrgaenge %}
    {% set grund = ausgefallen['j' ~ j]|default(null) %}
    {% set fehlende = fehlende|merge([ grund ? j ~ ' (' ~ grund ~ ')' : j ]) %}
  {% endif %}
{% endfor %}

{% include 'partials/pagehead-daten.html.twig' with {
  eyebrow: 'Medien · Resultate',
  titel: page.title,
  lead: page.header.intro,
  daten: [
    { wert: jahrgaenge|length, label: 'Jahrgänge', notiz: fehlende is not empty ? 'seit ' ~ jahrgaenge|last ~ ', ohne ' ~ fehlende|join(' und ') : 'lückenlos seit ' ~ jahrgaenge|last },
    { wert: listen|length,     label: 'Ranglisten', notiz: 'drei Abende plus Gesamt' },
    { wert: jahrgaenge|last,   label: 'Ältester Jahrgang', notiz: 'im Archiv abrufbar' },
    { wert: aktuell,           label: 'Neuester Jahrgang', notiz: include('partials/austragung.html.twig', { jahr: aktuell }) ~ '. Austragung' }
  ]
} %}

{% set gesamt = aktuell ? jahre['j' ~ aktuell].dateien['lgesamt']|default(null) : null %}
{% if gesamt %}
  <section class="section" style="padding-bottom:0;">
    <div class="wrap">
      <a class="result-highlight" href="{{ gesamt.url }}" download>
        <span>
          <h3>Gesamtrangliste {{ aktuell }}</h3>
          <p>Alle Kategorien über alle Abende · PDF, {{ (gesamt.size / 1024)|number_format(0, ',', '.') }} KB</p>
        </span>
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 3v13" stroke-linecap="round"/>
          <path d="m6.5 11.5 5.5 5.5 5.5-5.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M4 20h16" stroke-linecap="round"/>
        </svg>
      </a>
    </div>
  </section>
{% endif %}

{# Podest des neuesten Jahrgangs: Zeilen sind die Kategorien der
   Ausschreibung ohne Familienkategorien, Spalten die drei Abende und
   Gesamt. Namen und Zeiten liest rangliste_podest() aus den PDFs
   (classes/Rangliste.php, zwischengespeichert in user/data/ranglisten). #}
{% if page.header.podestaktiv|default(true) and aktuell %}
  {% set ausschreibung = pages.find('/ausschreibung') %}
  {# Älteste zuoberst, bei gleichem Alter Männer/Knaben vor Frauen/Mädchen –
     wie die Rekordkacheln der Startseite. #}
  {% set podestKategorien = (ausschreibung ? ausschreibung.header.kategorien|default([]) : [])
       |filter(k => k.kuerzel and k.gruppe|default('') != 'familie')
       |sort((a, b) => ((b.alter_min|default(0)) <=> (a.alter_min|default(0)))
                       ?: ((a.gruppe in ['frauen', 'maedchen'] ? 1 : 0) <=> (b.gruppe in ['frauen', 'maedchen'] ? 1 : 0))) %}
  {% set abendZeiten = (pages.find('/home').header.laufabende|default([]))
       |map(t => t.datum|date('U'))|filter(t => t|date('Y') == aktuell)|sort %}
  {% set podestSpalten = [
       { schluessel: '1', titel: '1. Abend', folgt: abendZeiten[0]|default(null) },
       { schluessel: '2', titel: '2. Abend', folgt: abendZeiten[1]|default(null) },
       { schluessel: '3', titel: '3. Abend', folgt: abendZeiten[2]|default(null) },
       { schluessel: 'gesamt', titel: 'Gesamt', folgt: abendZeiten|last|default(null) }
     ]|map(s => s|merge({ datei: jahre['j' ~ aktuell].dateien['l' ~ s.schluessel]|default(null) }))
      |map(s => s|merge({ daten: s.datei ? rangliste_podest(s.datei) : null })) %}

  {% if podestKategorien is not empty and podestSpalten|filter(s => s.datei) is not empty %}
    <section class="section" style="padding-bottom:0;">
      <div class="wrap">
        <div class="section__head">
          <h2>{{ (page.header.podesttitel|default('Podest {jahr}'))|replace({'{jahr}': aktuell}) }}</h2>
          <p class="section__aside">Die ersten drei jeder Kategorie · vollständige Listen als PDF</p>
        </div>

        {# Je Kategorie ein tbody: oben die Kategorie über die ganze Breite,
           darunter die vier Podeste. So bleibt die Tabelle in der normalen
           Seitenbreite, und jede Spalte hat Platz für Name, Ort und Zeit. #}
        <table class="podest">
          <caption class="visually-hidden">Die ersten drei je Kategorie und Laufabend {{ aktuell }}</caption>
          <thead>
            <tr>
              {% for s in podestSpalten %}
                <th scope="col"{{ s.schluessel == 'gesamt' ? ' class="is-gesamt"' : '' }}>
                  <span class="podest__titel">{{ s.titel }}</span>
                  <span class="podest__info">
                    {% if s.datei %}
                      {% if s.daten.datum %}<span>{{ s.daten.datum|date('d.m.Y') }}</span>{% endif %}
                      {% include 'partials/pdf-link.html.twig' with { datei: s.datei } %}
                    {% else %}
                      <span>folgt{{ s.folgt ? ' nach dem ' ~ s.folgt|date('d.m.') : '' }}</span>
                    {% endif %}
                  </span>
                </th>
              {% endfor %}
            </tr>
          </thead>
          {% for kat in podestKategorien %}
            <tbody{{ kat.gruppe in ['frauen', 'maedchen'] ? ' class="is-w"' : '' }}>
              <tr class="podest__gruppe">
                {# Die Kategorie läuft über die Abende; das Feld über Gesamt bleibt
                   leer, damit die Hinterlegung der Spalte nicht unterbricht. #}
                <th scope="rowgroup" colspan="{{ podestSpalten|length - 1 }}">
                  <span class="podest__kategorie">
                    {% include 'partials/gruppe-icon.html.twig' with { gruppe: kat.gruppe|default(''), klasse: 'podest__icon' } %}
                    <span class="podest__kat">{{ kat.bezeichnung }}</span>
                    <span class="podest__meta">
                      {%- if kat.alter_min -%}
                        {{ kat.alter_max
                            ? (kat.alter_min == kat.alter_max ? kat.alter_min ~ ' Jahre' : kat.alter_min ~ '–' ~ kat.alter_max ~ ' Jahre')
                            : 'ab ' ~ kat.alter_min ~ ' Jahren' }} ·
                      {%- endif %} {{ kat.distanz -}}
                    </span>
                  </span>
                </th>
                <td class="is-gesamt podest__luecke" aria-hidden="true"></td>
              </tr>
              <tr>
                {% for s in podestSpalten %}
                  {% set eintrag = s.daten ? (s.daten.kategorien|filter(k => k.kuerzel == kat.kuerzel)|first) : null %}
                  <td data-label="{{ s.titel }}"{{ s.schluessel == 'gesamt' ? ' class="is-gesamt"' : '' }}>
                    {% if eintrag and eintrag.plaetze is not empty %}
                      <ol class="podest__liste">
                        {% for p in eintrag.plaetze %}
                          <li>
                            <span class="podest__rang">{{ p.rang }}.</span>
                            <span class="podest__name">{{ p.name }}{% if p.ort %}, <span class="podest__ort">{{ p.ort }}</span>{% endif %}</span>
                            <strong class="podest__zeit">{{ p.zeit }}</strong>
                          </li>
                        {% endfor %}
                      </ol>
                    {% else %}
                      <span class="is-empty">—</span>
                    {% endif %}
                  </td>
                {% endfor %}
              </tr>
            </tbody>
          {% endfor %}
        </table>
      </div>
    </section>
  {% endif %}
{% endif %}

<section class="section">
  <div class="wrap">
    {% if jahrgaenge is empty %}
      <p class="section__aside">Noch keine Ranglisten hochgeladen.</p>
    {% else %}
      <div class="results">
        <table>
          <caption class="visually-hidden">Ranglisten nach Jahrgang und Laufabend</caption>
          <thead>
            <tr>
              <th scope="col">Jahrgang</th>
              {% for titel in spalten %}<th scope="col" class="is-center">{{ titel }}</th>{% endfor %}
            </tr>
          </thead>
          <tbody>
            {% for jahr in jahrgaenge %}
              <tr{{ jahr == aktuell ? ' class="is-current"' : '' }}>
                <th scope="row" class="results__year">
                  {{ jahr }} <small>{{ include('partials/austragung.html.twig', { jahr: jahr }) }}. Abendläufe</small>
                </th>
                {% for schluessel, spaltenTitel in spalten %}
                  <td class="is-center" data-label="{{ spaltenTitel }}">
                    {% include 'partials/pdf-link.html.twig' with { datei: jahre['j' ~ jahr].dateien['l' ~ schluessel]|default(null) } %}
                  </td>
                {% endfor %}
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}

    {% set weitere = page.media.all|filter(m => m.meta.art|default('') not in ['rangliste', '']) %}
    {% if weitere is not empty %}
      <h2 style="margin-top:3rem;">Weitere Dokumente</h2>
      <ul class="file-list">
        {% for name, d in weitere %}
          <li>
            <a href="{{ d.url }}" download>{{ d.meta.titel|default(name) }}</a>
            <span class="file-list__meta">{{ d.extension|upper }} · {{ (d.size / 1024)|number_format(0, ',', '.') }} KB</span>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</section>
{% if page.header.treueaktiv and page.header.treue %}
  <section class="section section--tint">
    <div class="wrap">
      <div class="section__head">
        <h2>{{ page.header.treuetitel|default('Jahr für Jahr dabei') }}</h2>
      </div>

      <ol class="loyal">
        {% for p in page.header.treue %}
          <li class="loyal__item">
            <span class="loyal__count">{{ p.jahre }}<small>von {{ p.von }}</small></span>
            <span class="loyal__who">
              <strong>{{ p.name }}</strong>
              <small>Jahrgang {{ p.jahrgang }}</small>
            </span>
          </li>
        {% endfor %}
      </ol>

      {% if page.header.treuehinweis %}
        <p class="chart__note">{{ page.header.treuehinweis }}</p>
      {% endif %}
    </div>
  </section>
{% endif %}

{% endblock %}
