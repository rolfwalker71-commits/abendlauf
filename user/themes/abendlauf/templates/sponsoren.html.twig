{% extends 'partials/base.html.twig' %}

{% block content %}
{% set alle = page.header.sponsoren|default([])|filter(s => s.aktiv) %}
{% set gruppen = { 'haupt': 'Hauptsponsoren', 'co': 'Co-Sponsoren', 'sponsor': 'Sponsoren', 'goenner': 'Gönner' } %}

{% include 'partials/pagehead-daten.html.twig' with {
  eyebrow: 'Patronat und Partner',
  titel: page.title,
  lead: page.header.intro,
  daten: [
    { wert: alle|length, label: 'Unterstützen uns', notiz: 'Firmen und Institutionen' },
    { wert: alle|filter(s => s.kategorie in ['haupt','co'])|length, label: 'Patronat', notiz: 'Hauptsponsor und Partner' },
    { wert: '1995', label: 'Seit', notiz: 'Jahr für Jahr dabei' }
  ]
} %}

{% for schluessel, titel in gruppen %}
  {% set teil = alle|filter(s => s.kategorie|default('sponsor') == schluessel) %}
  {% if teil is not empty %}
    <section class="section{{ schluessel == 'haupt' ? '' : ' section--tint' }}">
      <div class="wrap">
        <div class="section__head">
          <h2>{{ titel }}</h2>
          <p class="section__aside">{{ teil|length }}</p>
        </div>
        {# Vollständige Auflistung als Raster — jeder Sponsor mit Namen,
           damit die Seite auch ohne erkennbares Logo lesbar bleibt. #}
        {% if schluessel in ['haupt', 'co'] %}
          {% include 'partials/sponsors.html.twig' with { sponsoren: teil, medien: page } %}
        {% else %}
          <div class="sponsor-grid reveal">
            {% for s in teil %}
              {% set logo = s.logo ? page.media[s.logo|first] : null %}
              {% set inhalt %}
                <span class="sponsor-grid__logo">
                  {% if logo %}
                    <img src="{{ logo.url }}" alt="" loading="lazy">
                  {% endif %}
                </span>
                <span class="sponsor-grid__name">{{ s.name }}</span>
              {% endset %}
              {% if s.url %}
                <a class="sponsor-grid__item" href="{{ s.url }}" rel="noopener">{{ inhalt }}</a>
              {% else %}
                <div class="sponsor-grid__item">{{ inhalt }}</div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </section>
  {% endif %}
{% endfor %}
{% endblock %}
