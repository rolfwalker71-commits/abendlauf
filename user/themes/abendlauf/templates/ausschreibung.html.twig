{% extends 'partials/base.html.twig' %}

{% block content %}
{% set punkte     = page.header.punkte|default([]) %}
{% set kategorien = page.header.kategorien|default([]) %}
{% set dateien    = page.media.all|filter(m => m.extension|lower == 'pdf') %}

{# Distanzen und erste Startzeit werden abgeleitet, nicht eingetippt. #}
{% set runden = (pages.find('/strecke').header.runden)|default([]) %}
{% set nachZeit = kategorien|sort((a, b) => a.startzeit <=> b.startzeit) %}

{% set aktionen = '' %}
{% for name, d in dateien %}
  {% set aktionen = aktionen ~ '<a class="btn btn--primary" href="' ~ d.url ~ '" download>' ~ (d.meta.titel|default('Als PDF')) ~ '</a>' %}
{% endfor %}

{% include 'partials/pagehead-daten.html.twig' with {
  eyebrow: 'Informationen · ' ~ (page.header.kategorienjahr ?: ''),
  titel: page.title,
  lead: page.header.intro,
  aktionen: aktionen,
  daten: [
    { wert: kategorien|length, label: 'Kategorien', notiz: 'Vom Pfüderi bis zur Volksläuferin' },
    { wert: (nachZeit|first).startzeit, label: 'Erster Start', notiz: 'Anmeldung ab 16.30 Uhr' },
    { wert: runden|length > 0 ? (runden[0].distanz|replace({' m': ''})) : null, einheit: 'm',
      label: runden|length > 0 ? runden[0].titel : '', notiz: runden|length > 0 ? runden[0].kategorien|default(runden[0].untergrund) : '' },
    { wert: runden|length > 1 ? (runden[1].distanz|replace({' m': ''})) : null, einheit: 'm',
      label: runden|length > 1 ? runden[1].titel : '', notiz: runden|length > 1 ? runden[1].kategorien|default(runden[1].untergrund) : '' }
  ]
} %}

{% if kategorien is not empty %}
  {% set jahr = page.header.kategorienjahr %}

  {# Nach Startzeit gruppieren: um 18:50 starten sechs Kategorien
     gleichzeitig — als Tabellenzeilen war das nicht erkennbar.
     Schlüssel mit Präfix, weil PHP "1725" sonst zur Ganzzahl macht
     und array_merge Ganzzahl-Schlüssel neu durchnummeriert. #}
  {% set bloecke = {} %}
  {% for k in kategorien %}
    {% set zk = 'z' ~ k.startzeit %}
    {% set bisher = bloecke[zk]|default({ zeit: k.startzeit, kategorien: [] }) %}
    {% set bloecke = bloecke|merge({ (zk): {
         zeit: k.startzeit,
         kategorien: bisher.kategorien|merge([k])
       } }) %}
  {% endfor %}

  <section class="section">
    <div class="wrap">
      <div class="section__head">
        <h2>
          <span class="section__num">01</span> Kategorien und Startzeiten
          {% if jahr %}<small class="section__jahr">({{ jahr }})</small>{% endif %}
        </h2>
        <p class="section__aside">An allen drei Abenden identisch</p>
      </div>

      <ol class="startlist">
        {% for zk, block in bloecke %}
          <li class="startlist__slot">
            <div class="startlist__time">
              <span class="startlist__clock">{{ block.zeit }}</span>
              {% if block.kategorien|length > 1 %}
                <span class="startlist__count">{{ block.kategorien|length }} Kategorien</span>
              {% endif %}
            </div>

            <div class="startlist__cards">
              {% for k in block.kategorien %}
                {# Jahrgang aus dem Alter berechnen — so genügt nächstes
                   Jahr eine neue Zahl im Feld „gelten für das Jahr". #}
                {% set jg = null %}
                {% if jahr and k.alter_min %}
                  {% if k.alter_max %}
                    {% set von = jahr - k.alter_max %}
                    {% set bis = jahr - k.alter_min %}
                    {% set jg = von == bis ? von|string : von ~ ' – ' ~ bis %}
                  {% else %}
                    {% set jg = (jahr - k.alter_min) ~ ' und älter' %}
                  {% endif %}
                {% endif %}

                {% set gruppe = k.gruppe|default('') %}
                <article class="startcard startcard--{{ gruppe ?: 'ohne' }}">
                  <header class="startcard__head">
                    {% include 'partials/gruppe-icon.html.twig' with { gruppe: gruppe, klasse: 'startcard__icon' } %}
                    <h3 class="startcard__name">{{ k.bezeichnung }}</h3>
                    {% if k.kuerzel %}<span class="startcard__kat">{{ k.kuerzel }}</span>{% endif %}
                  </header>

                  <dl class="startcard__facts">
                    {% if jg %}
                      <div><dt>Jahrgang</dt><dd>{{ jg }}</dd></div>
                    {% endif %}
                    {% if k.alter_min %}
                      <div><dt>Alter</dt><dd>{{ k.alter_max ? (k.alter_min == k.alter_max ? k.alter_min ~ ' Jahre' : k.alter_min ~ '–' ~ k.alter_max ~ ' Jahre') : 'ab ' ~ k.alter_min ~ ' Jahren' }}</dd></div>
                    {% endif %}
                    {% if k.distanz %}
                      <div><dt>Distanz</dt><dd>{{ k.distanz }}{% if k.runden %} <span class="startcard__runden">{{ k.runden }}</span>{% endif %}</dd></div>
                    {% endif %}
                  </dl>

                  {% if k.startgeld %}
                    <p class="startcard__preis">{{ k.startgeld }}</p>
                  {% endif %}
                </article>
              {% endfor %}
            </div>
          </li>
        {% endfor %}
      </ol>
    </div>
  </section>
{% endif %}

{# Rechts neben „Organisatorisches“: Termine zum Abonnieren. Einleitung
   und Anleitung stehen auf der Seite /kalender (im Panel unter „Kalender“),
   die Daten kommen von den Laufabenden der Startseite. #}
{% set kalender = pages.find('/kalender') %}
{% set termine = (pages.find('/home').header.laufabende|default([]))
     |filter(t => t.datum and t.datum|date('U') >= 'today'|date('U'))
     |sort((a, b) => a.datum|date('U') <=> b.datum|date('U')) %}

{% if punkte is not empty or kalender %}
  <section class="section section--tint">
    <div class="wrap{{ kalender and punkte is not empty ? ' orga' : '' }}">
      {% if punkte is not empty %}
        <div>
          <h2><span class="section__num">02</span> Organisatorisches</h2>
          <div class="results">
            <table>
              <tbody>
                {% for p in punkte %}
                  <tr>
                    <th scope="row" style="width:11rem; vertical-align:top;">{{ p.stichwort }}</th>
                    <td>{{ p.text|markdown(false)|raw }}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      {% endif %}

      {% if kalender %}
        {% set ics = kalender.url(true) ~ '.ics' %}
        <aside class="kalenderkarte" aria-labelledby="kalenderkarte-titel">
          <p class="eyebrow">Termine</p>
          <h2 class="kalenderkarte__titel" id="kalenderkarte-titel">Laufabende im Kalender</h2>
          {% if termine is not empty %}
            <ul class="kalenderkarte__termine">
              {% for t in termine %}
                <li{% if t.status == 'abgesagt' %} class="ist-abgesagt"{% endif %}>
                  <span class="kalenderkarte__datum">{{ t.datum|date('j.n.') }}</span>
                  <span>{{ t.titel|default('Laufabend') }} · {{ t.datum|date('H:i') }} Uhr{% if t.status == 'abgesagt' %} · abgesagt{% endif %}</span>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
          {# Erster Absatz der Kalender-Seite als Erklärung #}
          {% set einleitung = kalender.content|split('</p>')|first %}
          {% if einleitung|striptags|trim %}<p class="kalenderkarte__text">{{ einleitung|striptags }}</p>{% endif %}
          <p class="kalenderkarte__knoepfe">
            <a class="btn btn--primary" href="{{ ics|replace({ 'https://': 'webcal://', 'http://': 'webcal://' }) }}">Kalender abonnieren</a>
            <a class="btn btn--ghost" href="{{ ics }}" download>Als Datei</a>
          </p>
          <p class="kalenderkarte__text"><a href="{{ kalender.url }}">Anleitung für iPhone, Google und Outlook</a></p>
        </aside>
      {% endif %}
    </div>
  </section>
{% endif %}
{% endblock %}
