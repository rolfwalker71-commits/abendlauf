{% extends 'partials/base.html.twig' %}

{% block content %}
{% set punkte     = page.header.punkte|default([]) %}
{% set kategorien = page.header.kategorien|default([]) %}
{% set dateien    = page.media.all|filter(m => m.extension|lower == 'pdf') %}

{% set aktionen = '' %}
{% for name, d in dateien %}
  {% set aktionen = aktionen ~ '<a class="btn btn--primary" href="' ~ d.url ~ '" download>' ~ (d.meta.titel|default('Als PDF')) ~ '</a>' %}
{% endfor %}

{% include 'partials/pagehead.html.twig' with {
  eyebrow: kategorien is not empty ? kategorien|length ~ ' Kategorien · Start ab ' ~ (kategorien|first).startzeit ~ ' Uhr' : null,
  titel: page.title,
  lead: page.header.intro,
  aktionen: aktionen,
  hintergrund: page.header.kopfhintergrund ? page.media[page.header.kopfhintergrund|first] : null
} %}

{% if kategorien is not empty %}
  {% set jahr = page.header.kategorienjahr %}

  {# Nach Startzeit gruppieren: um 18:50 starten sechs Kategorien
     gleichzeitig — als Tabellenzeilen war das nicht erkennbar.
     Schlüssel mit Präfix, weil PHP "1725" sonst zur Ganzzahl macht
     und array_merge Ganzzahl-Schlüssel neu durchnummeriert. #}
  {% set bloecke = {} %}
  {% for k in kategorien %}
    {% set zk = 'z' ~ k.startzeit %}
    {% set bisher = bloecke[zk]|default({ zeit: k.startzeit, kategorien: [] }) %}
    {% set bloecke = bloecke|merge({ (zk): {
         zeit: k.startzeit,
         kategorien: bisher.kategorien|merge([k])
       } }) %}
  {% endfor %}

  <section class="section">
    <div class="wrap">
      <div class="section__head">
        <h2>
          <span class="section__num">01</span> Kategorien und Startzeiten
          {% if jahr %}<small class="section__jahr">({{ jahr }})</small>{% endif %}
        </h2>
        <p class="section__aside">An allen drei Abenden identisch</p>
      </div>

      <ol class="startlist">
        {% for zk, block in bloecke %}
          <li class="startlist__slot">
            <div class="startlist__time">
              <span class="startlist__clock">{{ block.zeit }}</span>
              {% if block.kategorien|length > 1 %}
                <span class="startlist__count">{{ block.kategorien|length }} Kategorien</span>
              {% endif %}
            </div>

            <div class="startlist__cards">
              {% for k in block.kategorien %}
                {# Jahrgang aus dem Alter berechnen — so genügt nächstes
                   Jahr eine neue Zahl im Feld „gelten für das Jahr". #}
                {% set jg = null %}
                {% if jahr and k.alter_min %}
                  {% if k.alter_max %}
                    {% set von = jahr - k.alter_max %}
                    {% set bis = jahr - k.alter_min %}
                    {% set jg = von == bis ? von|string : von ~ ' – ' ~ bis %}
                  {% else %}
                    {% set jg = (jahr - k.alter_min) ~ ' und älter' %}
                  {% endif %}
                {% endif %}

                <article class="startcard">
                  <header class="startcard__head">
                    <h3 class="startcard__name">{{ k.bezeichnung }}</h3>
                    {% if k.kuerzel %}<span class="startcard__kat">{{ k.kuerzel }}</span>{% endif %}
                  </header>

                  <dl class="startcard__facts">
                    {% if jg %}
                      <div><dt>Jahrgang</dt><dd>{{ jg }}</dd></div>
                    {% endif %}
                    {% if k.alter_min %}
                      <div><dt>Alter</dt><dd>{{ k.alter_max ? (k.alter_min == k.alter_max ? k.alter_min ~ ' Jahre' : k.alter_min ~ '–' ~ k.alter_max ~ ' Jahre') : 'ab ' ~ k.alter_min ~ ' Jahren' }}</dd></div>
                    {% endif %}
                    {% if k.distanz %}
                      <div><dt>Distanz</dt><dd>{{ k.distanz }}{% if k.runden %} <span class="startcard__runden">{{ k.runden }}</span>{% endif %}</dd></div>
                    {% endif %}
                  </dl>

                  {% if k.startgeld %}
                    <p class="startcard__preis">{{ k.startgeld }}</p>
                  {% endif %}
                </article>
              {% endfor %}
            </div>
          </li>
        {% endfor %}
      </ol>
    </div>
  </section>
{% endif %}

{% if punkte is not empty %}
  <section class="section section--tint">
    <div class="wrap">
      <h2><span class="section__num">02</span> Organisatorisches</h2>
      <div class="results">
        <table>
          <tbody>
            {% for p in punkte %}
              <tr>
                <th scope="row" style="width:11rem; vertical-align:top;">{{ p.stichwort }}</th>
                <td>{{ p.text|markdown(false)|raw }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </section>
{% endif %}
{% endblock %}
