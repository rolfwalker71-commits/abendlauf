{#- Piktogramm für Männer, Frauen, Knaben, Mädchen und Familie.
    Erwartet: gruppe, optional klasse (CSS-Klasse des SVG)

    Erwachsene füllen die ganze Höhe, Kinder sind kleiner und haben
    einen verhältnismässig grösseren Kopf; Mädchen tragen Zöpfe. So
    bleibt die Unterscheidung auch ohne Farbe lesbar. Familie zeigt
    eine erwachsene Person Hand in Hand mit einem Kind. -#}
{%- set klasse = klasse|default('record__icon') -%}
{%- if gruppe == 'maenner' -%}
<svg class="{{ klasse }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
  <circle cx="12" cy="3.6" r="2.4"/>
  <path d="M8.6 7.4h6.8a1.6 1.6 0 0 1 1.6 1.6v6h-2.1v8h-2.5v-6.4h-.8V23H9.1v-8H7V9a1.6 1.6 0 0 1 1.6-1.6z"/>
</svg>
{%- elseif gruppe == 'frauen' -%}
<svg class="{{ klasse }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
  <circle cx="12" cy="3.6" r="2.4"/>
  <path d="M9.9 7.4h4.2a1.6 1.6 0 0 1 1.5 1.1l2.6 8.1h-3.1V23h-2.3v-6.4h-1.6V23H8.9v-6.4H5.8l2.6-8.1a1.6 1.6 0 0 1 1.5-1.1z"/>
</svg>
{%- elseif gruppe == 'knaben' -%}
<svg class="{{ klasse }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
  <circle cx="12" cy="8.3" r="2.9"/>
  <path d="M9.3 12.4h5.4a1.4 1.4 0 0 1 1.4 1.4v4.2h-1.7V23h-2v-4.2h-.8V23h-2v-5H7.9v-4.2a1.4 1.4 0 0 1 1.4-1.4z"/>
</svg>
{%- elseif gruppe == 'maedchen' -%}
<svg class="{{ klasse }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
  <circle cx="12" cy="8.3" r="2.9"/>
  <circle cx="8.3" cy="7.6" r="1.25"/>
  <circle cx="15.7" cy="7.6" r="1.25"/>
  <path d="M10.6 12.4h2.8a1.3 1.3 0 0 1 1.2.9l2 5.3h-2.3V23h-1.7v-4.4h-1.2V23H9.7v-4.4H7.4l2-5.3a1.3 1.3 0 0 1 1.2-.9z"/>
</svg>
{%- elseif gruppe == 'familie' -%}
<svg class="{{ klasse }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
  <circle cx="8.5" cy="3.6" r="2.3"/>
  <path d="M5.6 7.3h5.8a1.5 1.5 0 0 1 1.5 1.5v5.8h-1.9V23H8.9v-6.2h-.8V23H6v-8.4H4.1V8.8a1.5 1.5 0 0 1 1.5-1.5z"/>
  <path d="M12.9 13.7h2.2v1.3h-2.2z"/>
  <circle cx="18" cy="10.6" r="2"/>
  <path d="M16 13.6h4a1.1 1.1 0 0 1 1.1 1.1v3.4h-1.3V23h-1.5v-3.6h-.6V23h-1.5v-4.9h-1.3v-3.4a1.1 1.1 0 0 1 1.1-1.1z"/>
</svg>
{%- endif -%}
