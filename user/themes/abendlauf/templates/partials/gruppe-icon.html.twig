{#- Piktogramm für Männer, Frauen, Knaben, Mädchen. Erwartet: gruppe

    Erwachsene füllen die ganze Höhe, Kinder sind kleiner und haben
    einen verhältnismässig grösseren Kopf; Mädchen tragen Zöpfe. So
    bleibt die Unterscheidung auch ohne Farbe lesbar. -#}
{%- if gruppe == 'maenner' -%}
<svg class="record__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
  <circle cx="12" cy="3.6" r="2.4"/>
  <path d="M8.6 7.4h6.8a1.6 1.6 0 0 1 1.6 1.6v6h-2.1v8h-2.5v-6.4h-.8V23H9.1v-8H7V9a1.6 1.6 0 0 1 1.6-1.6z"/>
</svg>
{%- elseif gruppe == 'frauen' -%}
<svg class="record__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
  <circle cx="12" cy="3.6" r="2.4"/>
  <path d="M9.9 7.4h4.2a1.6 1.6 0 0 1 1.5 1.1l2.6 8.1h-3.1V23h-2.3v-6.4h-1.6V23H8.9v-6.4H5.8l2.6-8.1a1.6 1.6 0 0 1 1.5-1.1z"/>
</svg>
{%- elseif gruppe == 'knaben' -%}
<svg class="record__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
  <circle cx="12" cy="8.3" r="2.9"/>
  <path d="M9.3 12.4h5.4a1.4 1.4 0 0 1 1.4 1.4v4.2h-1.7V23h-2v-4.2h-.8V23h-2v-5H7.9v-4.2a1.4 1.4 0 0 1 1.4-1.4z"/>
