{%- elseif gruppe == 'maedchen' -%}
<svg class="record__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
  <circle cx="12" cy="8.3" r="2.9"/>
  <circle cx="8.3" cy="7.6" r="1.25"/>
  <circle cx="15.7" cy="7.6" r="1.25"/>
  <path d="M10.6 12.4h2.8a1.3 1.3 0 0 1 1.2.9l2 5.3h-2.3V23h-1.7v-4.4h-1.2V23H9.7v-4.4H7.4l2-5.3a1.3 1.3 0 0 1 1.2-.9z"/>
