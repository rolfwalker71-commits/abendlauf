{% set verein = config.site.verein %}
{% set startseite = pages.find('/home') %}
<!DOCTYPE html>
<html lang="de-CH">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{% if page.template == 'home' %}{{ verein.titel }}{% else %}{{ page.title }} — {{ verein.titel }}{% endif %}</title>
  {% set beschreibung = page.header.intro|default(config.site.metadata.description)|striptags|truncate(160, true, '…') %}
  {% set seitentitel = page.template == 'home' ? verein.titel : page.title ~ ' — ' ~ verein.titel %}

  {# Vorschaubild fürs Teilen: eigenes Bild der Seite, sonst das
     Kopfbild der Startseite. Ohne diese Angaben zeigen Facebook und
     Instagram beim Teilen nur einen nackten Link. #}
  {% set teilbild = null %}
  {% if page.header.herobild %}{% set teilbild = page.media[page.header.herobild|first] %}
  {% elseif page.header.kopfhintergrund %}{% set teilbild = page.media[page.header.kopfhintergrund|first] %}
  {% elseif page.media.images|length %}{% set teilbild = page.media.images|first %}
  {% elseif startseite.header.herobild %}{% set teilbild = startseite.media[startseite.header.herobild|first] %}
  {% endif %}

  <meta name="description" content="{{ beschreibung }}">
  <link rel="canonical" href="{{ page.url(true) }}">
  <meta name="theme-color" content="#00A0E8">

  <meta property="og:type" content="website">
  <meta property="og:locale" content="de_CH">
  <meta property="og:site_name" content="{{ verein.titel }}">
  <meta property="og:title" content="{{ seitentitel }}">
  <meta property="og:description" content="{{ beschreibung }}">
  <meta property="og:url" content="{{ page.url(true) }}">
  {% if teilbild %}
    {% set vorschau = teilbild.cropZoom(1200, 630) %}
    {# Absolute Adresse — Facebook und Co. verwerfen relative Pfade. #}
    <meta property="og:image" content="{{ base_url_absolute ~ vorschau.url }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ teilbild.meta.alt|default(seitentitel) }}">
  {% endif %}

  <meta name="twitter:card" content="{{ teilbild ? 'summary_large_image' : 'summary' }}">
  <meta name="twitter:title" content="{{ seitentitel }}">
  <meta name="twitter:description" content="{{ beschreibung }}">

  {# Farbschema VOR dem ersten Zeichnen setzen, sonst blitzt beim Laden
     kurz die falsche Variante auf. #}
  <script>
    try {
      var t = localStorage.getItem('theme');
      if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
    } catch (e) {}
  </script>

  {# Die beiden sofort sichtbaren Schnitte mit Vorrang laden — ohne das
     zeichnet der Browser erst mit der Systemschrift und tauscht sichtbar um. #}
  <link rel="preload" href="{{ url('theme://fonts/Oswald-600.woff2') }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ url('theme://fonts/SourceSans3-400.woff2') }}" as="font" type="font/woff2" crossorigin>

  <link rel="stylesheet" href="{{ url('theme://css/main.css') }}">
  <link rel="icon" href="{{ url('theme://img/logo.svg') }}" type="image/svg+xml">
</head>
<body>

{# Lesefortschritt — rein per CSS an das Scrollen gekoppelt. #}
<div class="progress" aria-hidden="true"></div>

{% if startseite.header.hinweisaktiv and startseite.header.hinweistext %}
  <div class="notice">
    {% if startseite.header.hinweislink %}
      <a href="{{ startseite.header.hinweislink }}">{{ startseite.header.hinweistext }}</a>
    {% else %}
      {{ startseite.header.hinweistext }}
    {% endif %}
  </div>
{% endif %}

<header class="site-header">
  <div class="wrap site-header__inner">

    {# Dass das Logo zur Startseite führt, ist Konvention — aber nichts
       zeigt es an, und auf Touchgeräten hilft kein Hover. Deshalb
       zusätzlich ein beschrifteter Eintrag im Menü. #}
    <a class="brand" href="{{ base_url == '' ? '/' : base_url }}"
       title="Zur Startseite" aria-label="Zur Startseite"
       {% if page.template == 'home' %}aria-current="page"{% endif %}>
      <span class="brand__logo">{{ svg_image('theme://img/logo.svg')|raw }}</span>
      <span class="brand__name">
        {{ verein.titel }}
        {% if verein.untertitel %}<span class="brand__sub">{{ verein.untertitel }}</span>{% endif %}
      </span>
    </a>

    {# Die wichtigste Seite steht rechts als Knopf und nicht mehr in
       der Liste — acht gleichrangige Einträge sagen nicht, wo man
       anfangen soll. Welche das ist, steht in den Vereinsangaben. #}
    {% set hauptaktion = verein.hauptaktion ? pages.find(verein.hauptaktion) : null %}

    <nav class="nav" id="nav" aria-label="Hauptnavigation">
      {# Nur das Symbol. Der Name steht als aria-label und title dran,
         sonst hätte der Verweis für Screenreader keine Bezeichnung. #}
      <a class="nav__start" href="{{ base_url == '' ? '/' : base_url }}"
         title="Startseite" aria-label="Startseite"
         {% if page.template == 'home' %}aria-current="page"{% endif %}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 11.5 12 4l8 7.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M6.5 10.5V20h11v-9.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      {% for eintrag in pages.children.visible %}
        {% if not hauptaktion or eintrag.url != hauptaktion.url %}
          <a href="{{ eintrag.url }}"{% if page.url starts with eintrag.url %} aria-current="page"{% endif %}>{{ eintrag.menu }}</a>
        {% endif %}
      {% endfor %}
      {% if hauptaktion %}
        {# Im aufgeklappten Menü schmaler Bildschirme gehört sie dazu #}
        <a class="nav__cta-mobil" href="{{ hauptaktion.url }}"{% if page.url starts with hauptaktion.url %} aria-current="page"{% endif %}>{{ hauptaktion.menu }}</a>
      {% endif %}
    </nav>

    <div class="site-header__tools">
      {% if hauptaktion %}
        <a class="btn btn--primary nav__cta" href="{{ hauptaktion.url }}">{{ hauptaktion.menu }}</a>
      {% endif %}
      <button class="theme-toggle" type="button" id="theme-toggle"
              aria-label="Zwischen hellem und dunklem Erscheinungsbild wechseln">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5"/>
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.5 1.5M17.6 17.6l1.5 1.5M19.1 4.9l-1.5 1.5M6.4 17.6l-1.5 1.5" stroke-linecap="round"/>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.8 6.8 0 0 0 10.5 10.5z" stroke-linejoin="round"/>
        </svg>
      </button>

      <button class="nav-toggle" type="button" id="nav-toggle" aria-controls="nav" aria-expanded="false" aria-label="Menü öffnen">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

  </div>
</header>

<main>
  {% block content %}{% endblock %}
</main>

<footer class="site-footer">
  <div class="wrap site-footer__cols">

    <div>
      <h3>{{ verein.titel }}</h3>
      {% if verein.adresse %}<p>{{ verein.adresse|nl2br }}</p>{% endif %}
    </div>

    <div>
      <h3>Kontakt</h3>
      {% if verein.email %}<p><a href="mailto:{{ verein.email }}">{{ verein.email }}</a></p>{% endif %}
      {% set kontakt = pages.find('/kontakt') %}
      {% if kontakt %}<p><a href="{{ kontakt.url }}">Kontaktformular</a></p>{% endif %}
      {# Rechtliches gehört in die Fusszeile, nicht in die Hauptnavigation. #}
      {% for route in ['/links', '/datenschutz', '/impressum'] %}
        {% set seite = pages.find(route) %}
        {% if seite %}<p><a href="{{ seite.url }}">{{ seite.title }}</a></p>{% endif %}
      {% endfor %}
    </div>

    <div>
      <h3>Folgen</h3>
      {% if verein.facebook %}<p><a href="{{ verein.facebook }}" rel="noopener">Facebook</a></p>{% endif %}
      {% if verein.instagram %}<p><a href="{{ verein.instagram }}" rel="noopener">Instagram</a></p>{% endif %}
    </div>

  </div>
  <div class="site-footer__base wrap">
    {{ verein.fusszeile ?: '© ' ~ 'now'|date('Y') ~ ' OK Urner Abendläufe' }}
  </div>
</footer>

<script src="{{ url('theme://js/site.js') }}" defer></script>
</body>
</html>
