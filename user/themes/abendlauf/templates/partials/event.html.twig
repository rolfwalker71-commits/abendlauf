{# Eine Laufabend-Kachel. Erwartet: termin (Zeile aus dem Feld laufabende) #}
{% set datum    = termin.datum|date('U') %}
{% set bild     = termin.bild ? page.media[termin.bild|first] : null %}
{% set status   = termin.status|default('findet-statt') %}
{% set abgesagt = status != 'findet-statt' %}
<article class="event {{ bild ? '' : 'event--plain' }} {{ abgesagt ? 'event--abgesagt' : '' }}">
  {% if bild %}
    <div class="event__media">{{ bild.cropZoom(800, 600).loading('lazy').html('')|raw }}</div>
  {% endif %}

  <div class="event__top">
    <span class="event__date">{{ datum|date('d.m.Y') }}</span>
    <span class="event__time">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2" stroke-linecap="round"/>
      </svg>
      {{ datum|date('H:i') }}
    </span>
  </div>

  <div>
    {% if termin.ort %}<p class="event__meta">{{ termin.ort }}</p>{% endif %}
    <h3 class="event__title">{{ termin.titel }}</h3>
    {# Der Hinweis erscheint auch bei einem normalen Termin — beim
       dritten Abend steht dort die Rangverkündigung, die vorher
       stillschweigend unter den Tisch fiel. #}
    {% if abgesagt %}
      <p class="event__status event__status--warn">
        {{ status == 'abgesagt' ? 'Abgesagt' : 'Verschoben' }}{{ termin.statushinweis ? ' · ' ~ termin.statushinweis : '' }}
      </p>
    {% elseif termin.statushinweis %}
      <p class="event__status">{{ termin.statushinweis }}</p>
    {% endif %}
  </div>
</article>
