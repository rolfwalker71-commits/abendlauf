{% extends 'partials/base.html.twig' %}

{% block content %}
{% set mitglieder = page.header.mitglieder|default([]) %}

{% include 'partials/pagehead-daten.html.twig' with {
  eyebrow: 'Der Verein',
  titel: page.title,
  lead: page.header.intro,
  daten: [
    { wert: mitglieder|length, label: 'Im Komitee', notiz: 'ehrenamtlich' },
    { wert: config.site.verein.gruendung, label: 'Seit', notiz: 'erste Austragung' },
    { wert: config.site.verein.untertitel, label: 'Organisator', notiz: 'Trägt den Anlass' }
  ]
} %}

<section class="section">
  <div class="wrap">
    <div class="grid grid--personen">
      {% for m in mitglieder %}
        {% set foto = m.portrait ? page.media[(m.portrait is iterable ? m.portrait|first : m.portrait)] : null %}
        <div class="person">
          <div class="person__img">
            {% if foto %}{{ foto.cropZoom(440, 440).loading('lazy').html(m.name)|raw }}{% endif %}
          </div>
          <p class="person__name">{{ m.name }}</p>
          <p class="person__role">{{ m.funktion }}</p>
          {% if m.email %}<p class="person__role"><a href="mailto:{{ m.email }}">{{ m.email }}</a></p>{% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endblock %}
