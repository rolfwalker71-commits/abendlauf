{% extends 'partials/base.html.twig' %}

{% block content %}
{% set h = page.header %}
{% set hero = h.herobild ? page.media[(h.herobild is iterable ? h.herobild|first : h.herobild)] : null %}

{# Die Austragungsnummer wird als eigenes Gestaltungselement gesetzt. #}
{% set teile = h.headline|default(page.title)|split('. ', 2) %}
{% set nummer = teile[0] matches '/^\\d+$/' ? teile[0] : null %}
{% set restTitel = nummer ? teile[1] : h.headline|default(page.title) %}

{# Nur Termine ab heute, chronologisch, höchstens drei. #}
{% set heute = 'today'|date('U') %}
{% set naechste = (h.laufabende|default([]))
     |filter(t => t.datum|date('U') >= heute)
     |sort((a, b) => a.datum|date('U') <=> b.datum|date('U'))
     |slice(0, 3) %}

{% set sponsorenSeite = pages.find('/sponsoren') %}
{% set alleSponsoren  = sponsorenSeite ? sponsorenSeite.header.sponsoren|default([]) : [] %}
{% set patronat       = alleSponsoren|filter(s => s.aktiv and s.kategorie in ['haupt', 'co']) %}

{# Strecken- und Vereinsdaten zuerst — die Kennzahlen greifen darauf zu. #}
{% set streckenRunden = (pages.find('/strecke').header.runden)|default([]) %}
{% set gruendung = config.site.verein.gruendung|default(1995) %}

{# Kennzahlen kommen aus der Ausschreibung, damit sie nie auseinanderlaufen. #}
{% set ausschreibung = pages.find('/ausschreibung') %}
{% set kategorien = ausschreibung ? ausschreibung.header.kategorien|default([]) : [] %}
{% set kennzahlen = [] %}
{% if kategorien is not empty %}
  {% set gelder = kategorien|map(k => k.startgeld|replace({'CHF': ''})|trim|number_format(0, '.', ''))|filter(g => g > 0) %}
  {% set kleine = (kategorien|filter(k => 'kleine' in k.runden)|first).distanz|default(null) %}
  {% set kennzahlen = [
      { label: 'Kleine Runde', wert: kleine,   notiz: 'Rund ums Schloss A Pro' },
      { label: streckenRunden|length > 1 ? streckenRunden[1].titel : 'Grosse Runde',
        wert: streckenRunden|length > 1 ? streckenRunden[1].distanz : null,
        notiz: streckenRunden|length > 1 ? streckenRunden[1].untergrund : '' },
      { label: 'Kategorien',   wert: kategorien|length, notiz: 'Vom Pfüderi bis zur Volksläuferin' },
      { label: 'Startgeld',    wert: gelder is not empty ? 'CHF ' ~ min(gelder) ~ '–' ~ max(gelder) : null,
        notiz: 'Anmeldung vor Ort' }
    ]|filter(k => k.wert) %}
{% endif %}

{% set fotoSeite = pages.find('/fotos') %}
{% set alben = fotoSeite ? fotoSeite.children.visible|slice(0, 3) : [] %}

{# Streckenkarten von der Streckenseite holen — sie lagen bisher nur dort. #}
{% set streckenSeite = pages.find('/strecke') %}
{% set karten = [] %}
{% if streckenSeite %}
  {% for runde in streckenSeite.header.runden|default([]) %}
    {% if runde.karte %}
      {% set k = streckenSeite.media[(runde.karte is iterable ? runde.karte|first : runde.karte)] %}
      {% if k %}{% set karten = karten|merge([{ bild: k, titel: runde.titel, distanz: runde.distanz }]) %}{% endif %}
    {% endif %}
  {% endfor %}
{% endif %}

{# Bilder für die Fotostreifen: gleichmässig über das neueste Album
   verteilt, damit die Streifen nicht dreimal dieselbe Szene zeigen. #}
{% set streifenA = [] %}
{% set streifenB = [] %}
{% if alben|length > 0 %}
  {% set quelle = (alben|first).media.images %}
  {% set namen = quelle|keys %}
  {% if namen|length > 12 %}
    {% for i in 0..4 %}
      {% set streifenA = streifenA|merge([ quelle[ namen[ (namen|length / 6 * i)|round(0, 'floor') ] ] ]) %}
      {% set streifenB = streifenB|merge([ quelle[ namen[ (namen|length - 1 - (namen|length / 7 * i))|round(0, 'floor') ] ] ]) %}
    {% endfor %}
  {% endif %}
{% endif %}

{# Randloser Auftakt: das Bild über die volle Breite, der Text davor.
   Abgedunkelt wird nur die untere Hälfte, wo der Text sitzt — oben
   bleibt das Bild unangetastet. Die Schrift ist hier immer hell,
   unabhängig vom Farbschema, weil sie auf dem Bild liegt. #}
<section class="opener {{ hero ? '' : 'opener--plain' }}">
  {% if hero %}
    <div class="opener__media">{{ hero.cropZoom(1920, 1080).html()|raw }}</div>
  {% endif %}

  <div class="wrap opener__inner">
    {% include 'partials/runlogo.html.twig' %}

    <p class="opener__eyebrow">{{ config.site.verein.untertitel }} · Seedorf am Urnersee</p>

    <p class="opener__edition">{{ nummer }}<span class="hero__dot">.</span></p>
    {% set anlassJahr = naechste is not empty ? (naechste|first).datum|date('Y') : null %}
    <h1 class="opener__title">{{ restTitel }}{% if anlassJahr %} <span class="opener__jahr">{{ anlassJahr }}</span>{% endif %}</h1>

    {% if h.subline %}<p class="opener__lead">{{ h.subline }}</p>{% endif %}

    {% if naechste is not empty %}
      {% set naechster = naechste|first %}
      {% set ziel = naechster.datum|date('U') %}
      <div class="countdown" data-countdown="{{ ziel|date('c') }}" aria-live="off">
        <div class="countdown__unit"><span class="countdown__value" data-unit="tage">–</span><span class="countdown__label">Tage</span></div>
        <div class="countdown__unit"><span class="countdown__value" data-unit="stunden">–</span><span class="countdown__label">Stunden</span></div>
        <div class="countdown__unit"><span class="countdown__value" data-unit="minuten">–</span><span class="countdown__label">Minuten</span></div>
      </div>
      <p class="opener__note">
        bis zum Start: {{ naechster.titel }}, {{ ziel|date('d.m.Y') }} um {{ ziel|date('H:i') }} Uhr
      </p>
    {% endif %}

    <div class="hero__actions">
      {% if ausschreibung %}<a class="btn btn--primary" href="{{ ausschreibung.url }}">Ausschreibung</a>{% endif %}
      {% set ranglisten = pages.find('/ranglisten') %}
      {% if ranglisten %}<a class="btn btn--hell" href="{{ ranglisten.url }}">Ranglisten</a>{% endif %}
    </div>
  </div>
</section>

{# Mitteilung auf Zeit. Sie steht vor allem anderen, trägt aber keine
   Abschnittsnummer — sie gehört nicht zum festen Aufbau der Seite.
   Das Datum „Anzeigen bis" blendet sie von selbst aus; ohne diese
   Bremse bleibt so ein Text erfahrungsgemäss jahrelang stehen. #}
{% set insachen_faellig = h.insachenbis ? h.insachenbis|date('U') < 'today'|date('U') : false %}
{% if h.insachenaktiv and h.insachentext and not insachen_faellig %}
  <section class="section section--overlap">
    <div class="wrap">
      <aside class="interim">
        <div class="interim__head">
          <p class="interim__label">Vorübergehender Hinweis</p>
          <h2 class="interim__title">{{ h.insachentitel|default('In eigener Sache') }}</h2>
        </div>
        <div class="interim__body prose">
          {{ h.insachentext|markdown|externe_links|raw }}
        </div>
      </aside>
    </div>
  </section>
{% endif %}

{% if h.aktuellaktiv and h.aktuelltext %}
  <section class="section{{ (h.insachenaktiv and h.insachentext and not insachen_faellig) ? '' : ' section--overlap' }}">
    <div class="wrap">
      <div class="notice-panel">
        <div class="notice-panel__head">
          <p class="eyebrow" style="margin:0;">Vom OK</p>
          <h2><span class="section__num">01</span> {{ h.aktuelltitel|default('Aktuell') }}</h2>
          {% if h.aktuellstand %}
            <p class="notice-panel__date">Stand {{ h.aktuellstand|date('d.m.Y') }}</p>
          {% endif %}
        </div>
        <div class="notice-panel__body prose">
          {{ h.aktuelltext|markdown|externe_links|raw }}
        </div>
      </div>
    </div>
  </section>
{% endif %}

{% if naechste is not empty %}
  <section class="section section--tint">
    <div class="wrap">
      <div class="section__head">
        <h2><span class="section__num">02</span> Die nächsten Laufabende</h2>
        <p class="section__aside">Anmeldung jeweils ab 16.30 Uhr vor Ort</p>
      </div>
      <div class="grid grid--3 reveal">
        {% for termin in naechste %}{% include 'partials/event.html.twig' %}{% endfor %}
      </div>
    </div>
    {% include 'partials/trenner.html.twig' with { art: 'berge', farbe: '--band-bg' } %}
  </section>
{% endif %}

{% if kennzahlen is not empty %}
  <section class="band">
    {# Die Läufergruppe als blasser Fries — mehrfach, damit sie das
       ganze Band trägt. Eigenes Motiv, als Vektor beliebig gross. #}
    <div class="band__frieze" aria-hidden="true">
      {% for i in 1..7 %}{{ svg_image('theme://img/logo.svg')|raw }}{% endfor %}
    </div>

    <div class="wrap">
      <div class="band__head">
        <h2><span class="section__num">03</span> Die Abendläufe in Zahlen</h2>
        {% if ausschreibung %}
          <p class="band__aside"><a href="{{ ausschreibung.url }}">Ganze Ausschreibung</a></p>
        {% endif %}
      </div>

      <div class="bignums reveal">
        <div class="bignum">
          <p class="bignum__value">{{ gruendung }}</p>
          <p class="bignum__label">Seit</p>
          {% if nummer %}<p class="bignum__note">{{ nummer }}. Austragung</p>{% endif %}
        </div>
        {# Zahl der Abende aus den gepflegten Terminen, nicht eingetippt #}
        {% set abende = (h.laufabende|default([]))|length %}
        {% if abende > 0 %}
          <div class="bignum">
            <p class="bignum__value">{{ abende }}<small>{{ abende == 1 ? 'Abend' : 'Abende' }}</small></p>
            <p class="bignum__label">Jeden Sommer</p>
            <p class="bignum__note">Mittwochs, August und September</p>
          </div>
        {% endif %}
        {% if h.alterVon and h.alterBis %}
          <div class="bignum">
            <p class="bignum__value">{{ h.alterVon }}–{{ h.alterBis }}<small>Jahre</small></p>
            <p class="bignum__label">Altersspanne</p>
            <p class="bignum__note">Jüngste und älteste Gewertete</p>
          </div>
        {% endif %}
        {% if h.anteilKinder %}
          <div class="bignum">
            <p class="bignum__value">{{ h.anteilKinder }}<small>%</small></p>
            <p class="bignum__label">Kinder und Eltern</p>
            <p class="bignum__note">Kein Volkslauf mit Kinderprogramm — umgekehrt</p>
          </div>
        {% endif %}
        {% for k in kennzahlen %}
          <div class="bignum">
            <p class="bignum__value">{{ k.wert|replace({' m': '', 'CHF ': ''}) }}<small>{{ ' m' in k.wert ? 'm' : ('CHF' in k.wert ? 'CHF' : '') }}</small></p>
            <p class="bignum__label">{{ k.label }}</p>
            <p class="bignum__note">{{ k.notiz }}</p>
          </div>
        {% endfor %}
      </div>

      {% if karten is not empty %}
        <div class="band__maps">
          {% for k in karten %}
            <figure class="band__map">
              <a href="{{ k.bild.url }}" data-lightbox data-caption="{{ k.titel }} · {{ k.distanz }}">
                {{ k.bild.cropZoom(560, 380).loading('lazy').html()|raw }}
              </a>
              <figcaption>{{ k.titel }} · {{ k.distanz }}</figcaption>
            </figure>
          {% endfor %}
        </div>
      {% endif %}
    </div>
    {% include 'partials/trenner.html.twig' with { art: 'see', farbe: '--bg' } %}
  </section>
{% endif %}

{% if h.rekordeaktiv and h.rekorde %}
  <section class="section">
    <div class="wrap">
      <div class="section__head">
        <h2><span class="section__num">04</span> {{ h.rekordetitel|default('Streckenrekorde') }}</h2>
        {% if h.rekordehinweis %}<p class="section__aside">{{ h.rekordehinweis }}</p>{% endif %}
      </div>

      <div class="records reveal">
        {% for r in h.rekorde %}
          <article class="record">
            <p class="record__kat">{{ r.kategorie }}</p>
            <p class="record__time">{{ r.zeit }}</p>
            <p class="record__who">{{ r.name }}{% if r.ort %}<small>{{ r.ort }}</small>{% endif %}</p>
            <p class="record__meta">{{ r.datum ? r.datum|date('Y') : r.jahr }} · {{ r.distanz }}</p>
            {# Frühere Streckenlängen stehen daneben, nicht darin: die Zeiten
               sind über eine andere Distanz gelaufen und nicht vergleichbar. #}
            {% if r.frueher %}<p class="record__frueher">{{ r.frueher }}</p>{% endif %}
          </article>
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}

{% include 'partials/fotostreifen.html.twig' with { bilder: streifenA, hoehe: 210 } %}

{% if alben is not empty %}
  <section class="section section--tint">
    <div class="wrap">
      <div class="section__head">
        <h2><span class="section__num">05</span> Aus den Alben</h2>
        <p class="section__aside"><a href="{{ fotoSeite.url }}">Alle Alben</a></p>
      </div>
      <div class="bleed-strip">
        {% for album in alben %}
          {% set cover = album.header.cover ? album.media[(album.header.cover is iterable ? album.header.cover|first : album.header.cover)] : album.media.images|first %}
          <a class="album-card" href="{{ album.url }}">
            <div class="album-card__img">
              {% if cover %}{{ cover.cropZoom(800, 534).loading('lazy').html('')|raw }}{% endif %}
            </div>
            <h3 class="album-card__title">{{ album.title }}</h3>
            <p class="album-card__meta">{{ album.media.images|length }} Bilder</p>
          </a>
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}

{% if h.aktionaktiv and h.aktiontext %}
  <section class="section">
    <div class="wrap">
      <div class="offer">
        <div class="offer__text">
          {% if h.aktionpartner %}<p class="eyebrow">{{ h.aktionpartner }}</p>{% endif %}
          <h2><span class="section__num">06</span> {{ h.aktiontitel|default('Aktion') }}</h2>
          <div class="prose">{{ h.aktiontext|markdown|externe_links|raw }}</div>
          {% if h.aktionlink %}
            <p style="margin-top:1.4rem;">
              <a class="btn btn--primary" href="{{ h.aktionlink }}" target="_blank" rel="noopener">
                {{ h.aktionlinktext|default('Mehr erfahren') }}
              </a>
            </p>
          {% endif %}
        </div>

        {% if h.aktionbilder %}
          <div class="offer__media">
            {% for name in h.aktionbilder %}
              {% set bild = page.media[name] %}
              {% if bild %}
                <a href="{{ bild.url }}" data-lightbox data-caption="{{ bild.meta.alt|default('') }}">
                  {{ bild.resize(700).loading('lazy').html(bild.meta.alt|default(''))|raw }}
                </a>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </section>
{% endif %}

{% include 'partials/fotostreifen.html.twig' with { bilder: streifenB, hoehe: 170 } %}

{% if patronat is not empty %}
  <section class="section section--tint">
    <div class="wrap">
      <div class="section__head">
        <h2><span class="section__num">07</span> Patronat</h2>
        {% if sponsorenSeite %}
          <p class="section__aside">
            <a href="{{ sponsorenSeite.url }}">Alle {{ (alleSponsoren|filter(s => s.aktiv))|length }} Sponsoren ansehen</a>
          </p>
        {% endif %}
      </div>
      {% include 'partials/sponsors.html.twig' with { sponsoren: patronat, medien: sponsorenSeite } %}
    </div>
  </section>
{% endif %}
{% endblock %}
