/site/config/.license

# ===================================================================
# Projektspezifisch
# ===================================================================

# Aufgegebener Next.js-Prototyp (enthält node_modules, 1,2 GB)
/_archiv-nextjs/

# Medienarchive: liegen auf dem Server und auf abendlauf.ch.
# Git eignet sich schlecht für Binärdateien — jede Änderung würde
# die Datei vollständig neu speichern und bliebe für immer in der
# Versionsgeschichte. Wieder einspielen: siehe werkzeuge/
/content/4_fotos/*/*.jpg
/content/4_fotos/*/*.jpeg
/content/**/*.pdf

# Ungespeicherte Panel-Änderungen: Kirby legt Entwürfe unter
# _changes/ ab, bis jemand im Panel auf Speichern klickt. Das ist
# Arbeitsstand einer einzelnen Person, kein Inhalt.
_changes/

# Zwischenergebnisse
*.tmp
*.bak
