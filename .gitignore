# ===================================================================
#  Urner Abendläufe — was nicht ins Repository gehört
# ===================================================================

# --- Grav selbst -----------------------------------------------------
# Das CMS wird nicht versioniert, sondern mit dem offiziellen Paket
# geholt: werkzeuge/grav-einrichten.sh. Sonst lägen 75 MB Fremdcode
# in der Versionsgeschichte, und ein Grav-Update würde als riesiger
# Commit erscheinen.
/system/
/vendor/
/bin/
/user/plugins/
/index.php
/composer.json
/composer.lock
/robots.txt
/now.json
/webserver-configs/
/CHANGELOG.md
/.env.example
/CODE_OF_CONDUCT.md
/CONTRIBUTING.md
/LICENSE.txt
/SECURITY.md

# --- Von Grav erzeugt ------------------------------------------------
/cache/
/logs/
/tmp/
/backup/
/images/
/assets/
/user/data/
/user/config/versions.yaml

# --- SICHERHEIT: niemals veröffentlichen -----------------------------
/user/accounts/
/user/config/security.yaml
# Von Grav erzeugter Signaturschlüssel für CSRF-Prüfungen. Die Datei
# sagt es selbst: "Do NOT commit to version control."
/user/config/security-private.php
/.env
/.env.local

# --- Medienarchive ---------------------------------------------------
# Liegen auf dem Server und auf abendlauf.ch. Git eignet sich schlecht
# für Binärdateien; einmal eingecheckt bleiben sie für immer in der
# Versionsgeschichte. Wieder einspielen: siehe werkzeuge/
/user/pages/05.fotos/*/*.jpg
/user/pages/05.fotos/*/*.jpeg
/user/pages/**/*.pdf

# --- Aufgegebener Next.js-Prototyp -----------------------------------
/_archiv-nextjs/

# --- System und Werkzeuge --------------------------------------------
.DS_Store
Icon
Thumbs.db
# Windows hängt an heruntergeladene Dateien eine Begleitdatei an
*:Zone.Identifier
*.tmp
*.bak
*.sublime-workspace
/.vscode
/.idea

# Python-Zwischenstand
__pycache__/
